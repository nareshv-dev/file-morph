{
  "name": "filemorph-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names API,WEB --prefix-colors green,blue \"python -m uvicorn backend.main:app --reload --reload-dir ../backend --port 8001 --app-dir ..\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "python -m uvicorn backend.main:app --reload --reload-dir ../backend --port 8001 --app-dir ..",
    "build": "vite build",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^30.0.1",
    "vite": "^7.1.4",
    "vitest": "^5.0.0"
  }
}
